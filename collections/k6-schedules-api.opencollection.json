{
  "opencollection": "1.0.0",
  "info": {
    "name": "Grafana Cloud k6 REST Load tests Schedules API",
    "version": "6.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Schedules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List schedules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.k6.io/cloud/v6/schedules",
            "headers": [
              {
                "name": "X-Stack-Id",
                "value": ""
              }
            ]
          },
          "docs": "Return scheduled load-test executions for the Grafana stack."
        }
      ]
    }
  ],
  "bundled": true
}